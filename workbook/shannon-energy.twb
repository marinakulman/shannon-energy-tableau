      <column caption='Retention Rate' datatype='real' default-format='p0.0%' name='[Calculation_2794116629438497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([EligibleN]) &gt; 0&#10;THEN SUM([RetainedN]) / SUM([EligibleN])&#10;END' />
