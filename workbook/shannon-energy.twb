    <worksheet name='Channel Plan Table'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontname='Helvetica Neue' fontsize='20'>Plan achievement by channel</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true'>FACT</run>
            <run>: all seven channels showed a negative deviation from the plan, in the range of -1.4% ... -6.4%. Total 25,998 versus 27,142.
</run>
            <run bold='true'>INFERENCE</run>
            <run>: Uniformity of deviation indicates a systemic cause rather than a problem with individual channels.
</run>
            <run bold='true'>HYPOTHESIS</run>
            <run>: planned values ​​could be set from top to bottom of target growth. It is impossible to check using the data - there is no planning methodology in the sources.Actual Acquisitions, Target Acquisitions and Acquisition Variance % broken down by Channel Name.  Color shows details about Variance Status.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='PlanPerformance' name='federated.04vexel131hrko1g8851s1m17b1d' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='pStartMonth' datatype='date' name='[Parameter 2794116622106624]' param-domain-type='range' role='measure' type='quantitative' value='#2023-01-01#'>
              <calculation class='tableau' formula='#2023-01-01#' />
              <range granularity='1' max='#2026-06-10#' min='#2023-01-01#' period-type-v2='month' />
            </column>
            <column caption='pEndMonth' datatype='date' name='[Parameter 2794116622622721]' param-domain-type='range' role='measure' type='quantitative' value='#2026-06-01#'>
              <calculation class='tableau' formula='#2026-06-01#' />
              <range granularity='1' max='#2026-06-01#' min='#2023-01-01#' period-type-v2='month' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.04vexel131hrko1g8851s1m17b1d'>
            <column caption='Actual Acquisitions' datatype='integer' name='[ActualAcquisitions]' role='measure' type='quantitative' />
            <column caption='Acquisition Variance %' datatype='real' default-format='p0.0%' name='[Calculation_2794116629790756]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([TargetAcquisitions]) &gt; 0&#10;THEN SUM([ActualAcquisitions]) / SUM([TargetAcquisitions]) - 1&#10;END' />
            </column>
            <column caption='Variance Status' datatype='string' name='[Calculation_2794116629860389]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([TargetAcquisitions]) = 0 THEN &quot;Plan not specified&quot;&#10;ELSEIF SUM([ActualAcquisitions]) &gt;= SUM([TargetAcquisitions]) THEN &quot;On the plan or above&quot;&#10;ELSE &quot;Below plan&quot;&#10;END' />
            </column>
            <column caption='In Period' datatype='boolean' name='[Calculation_2794116630188070]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[MonthStart] &gt;= [Parameters].[Parameter 2794116622106624] AND [MonthStart] &lt;= [Parameters].[Parameter 2794116622622721]' />
            </column>
            <column caption='Channel Name' datatype='string' name='[ChannelName]' role='dimension' type='nominal' />
            <column caption='Month Start' datatype='date' name='[MonthStart]' role='dimension' type='ordinal' />
            <column caption='Target Acquisitions' datatype='integer' name='[TargetAcquisitions]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2794116630188070]' derivation='None' name='[none:Calculation_2794116630188070:nk]' pivot='key' type='nominal' />
            <column-instance column='[ChannelName]' derivation='None' name='[none:ChannelName:nk]' pivot='key' type='nominal' />
            <column-instance column='[ActualAcquisitions]' derivation='Sum' name='[sum:ActualAcquisitions:qk]' pivot='key' type='quantitative' />
            <column-instance column='[TargetAcquisitions]' derivation='Sum' name='[sum:TargetAcquisitions:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2794116629790756]' derivation='User' name='[usr:Calculation_2794116629790756:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2794116629860389]' derivation='User' name='[usr:Calculation_2794116629860389:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
