      <aliases enabled='yes' />
      <column caption='Acquisition Cost' datatype='real' name='[AcquisitionCost]' role='measure' type='quantitative' />
      <column caption='Business Type' datatype='string' name='[BusinessType]' role='dimension' type='nominal' />
      <column caption='SUM([Acquisitions])' datatype='real' name='[Calculation_2794116624113669]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Acquisitions])' />
      </column>
      <column caption='Net Adds' datatype='real' name='[Calculation_2794116624441350]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Acquisitions]) - SUM([ChurnedCustomers])' />
      </column>
      <column caption='Acquisition Cost Total' datatype='real' name='[Calculation_2794116624510983]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([AcquisitionCost])' />
      </column>
      <column caption='CPA' datatype='real' name='[Calculation_2794116624580616]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Acquisitions]) &gt; 0&#10;THEN SUM([AcquisitionCost]) / SUM([Acquisitions])&#10;END' />
      </column>
      <column caption='Churn Numerator' datatype='real' name='[Calculation_2794116624662537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IIF([MonthEligibleForChurnRate] = 1, [ChurnedCustomers], 0) )' />
      </column>
      <column caption='Churn Denominator' datatype='real' name='[Calculation_2794116624760842]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IIF([MonthEligibleForChurnRate] = 1, [OpeningCustomers], 0) )' />
      </column>
      <column caption='Monthly Churn Rate' datatype='real' default-format='p0.00%' name='[Calculation_2794116624846859]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2794116624760842] &gt; 0&#10;THEN [Calculation_2794116624662537] / [Calculation_2794116624760842]&#10;END' />
      </column>
      <column caption='Closing Base' datatype='real' name='[Calculation_2794116625272845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF [MonthStart] = [Calculation_2794116627771409] THEN [ClosingCustomers] END )' />
      </column>
      <column caption='Monthly ARPU' datatype='real' name='[Calculation_2794116625997838]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([ClosingCustomers]) &gt; 0&#10;THEN SUM([Revenue]) / SUM([ClosingCustomers])&#10;END' />
      </column>
      <column caption='Last Observed Month' datatype='date' name='[Calculation_2794116627771409]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX( IF [MonthStart] &lt;= [Parameters].[Parameter 2794116622622721] AND [RevenueObservationCount] = 1&#10;               THEN [MonthStart] END ) }' />
      </column>
      <column caption='AnchorMonth' datatype='date' name='[Calculation_2794116628402196]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED : MAX( IF [RevenueObservationCount] = 1 AND [MonthStart] &lt;= [Parameters].[Parameter 2794116622622721]&#10;               THEN [MonthStart] END ) }' />
      </column>
      <column caption='Revenue Rolling 12M' datatype='real' default-format='c&quot;€&quot;#,##0,,.0M;-&quot;€&quot;#,##0,,.0M' name='[Calculation_2794116628463637]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;  IF [MonthStart] &gt;= DATEADD(&apos;month&apos;, -11, [Calculation_2794116628402196])&#10;     AND [MonthStart] &lt;= [Calculation_2794116628402196]&#10;  THEN [Revenue]&#10;  END&#10;)' />
      </column>
      <column caption='In Period' datatype='boolean' name='[Calculation_2794116628566038]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[MonthStart] &gt;= [Parameters].[Parameter 2794116622106624] AND [MonthStart] &lt;= [Parameters].[Parameter 2794116622622721]' />
      </column>
      <column caption='Segment Filter' datatype='boolean' name='[Calculation_2794116628639767]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2794116622929922] = &quot;All&quot; OR [SegmentCode] = [Parameters].[Parameter 2794116622929922]' />
      </column>
      <column caption='Channel Filter' datatype='boolean' name='[Calculation_2794116628688920]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2794116623314947] = &quot;All&quot; OR [ChannelCode] = [Parameters].[Parameter 2794116623314947]' />
      </column>
