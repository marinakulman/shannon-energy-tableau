              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.04vexel131hrko1g8851s1m17b1d].[sum:ActualAcquisitions:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.04vexel131hrko1g8851s1m17b1d].[sum:TargetAcquisitions:qk]&quot;' />
