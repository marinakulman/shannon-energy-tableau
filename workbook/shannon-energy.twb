    <worksheet name='Churn Risk by Tenure'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontname='Helvetica Neue' fontsize='20'>Churn risk by tenure</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run>The peak at the 12-month mark coincides with the expiration of 12-month contracts. The data do not confirm a causal link.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='RetentionCohorts' name='federated.1hc7va50hpvtky1fj0kdd1eqqse1' />
