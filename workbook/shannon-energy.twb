            <column caption='pStartMonth' datatype='date' name='[Parameter 2794116622106624]' param-domain-type='range' role='measure' type='quantitative' value='#2023-01-01#'>
              <calculation class='tableau' formula='#2023-01-01#' />
              <range granularity='1' max='#2026-06-10#' min='#2023-01-01#' period-type-v2='month' />
            </column>
            <column caption='pEndMonth' datatype='date' name='[Parameter 2794116622622721]' param-domain-type='range' role='measure' type='quantitative' value='#2026-06-01#'>
              <calculation class='tableau' formula='#2026-06-01#' />
              <range granularity='1' max='#2026-06-01#' min='#2023-01-01#' period-type-v2='month' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1hc7va50hpvtky1fj0kdd1eqqse1'>
            <column caption='At Risk N' datatype='integer' name='[AtRiskN]' role='measure' type='quantitative' />
            <column caption='Tenure Churn Rate' datatype='real' default-format='p0.0%' name='[Calculation_2794116629536802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([AtRiskN]) &gt; 0&#10;THEN SUM([ChurnAtN]) / SUM([AtRiskN])&#10;END' />
            </column>
            <column caption='In Period (Cohort)' datatype='boolean' name='[Calculation_2794116629631011]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[CohortMonth] &gt;= [Parameters].[Parameter 2794116622106624] AND [CohortMonth] &lt;= [Parameters].[Parameter 2794116622622721]' />
