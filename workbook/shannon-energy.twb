      <column caption='Acquisition Variance %' datatype='real' default-format='p0.0%' name='[Calculation_2794116629790756]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([TargetAcquisitions]) &gt; 0&#10;THEN SUM([ActualAcquisitions]) / SUM([TargetAcquisitions]) - 1&#10;END' />
      </column>
      <column caption='Variance Status' datatype='string' name='[Calculation_2794116629860389]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([TargetAcquisitions]) = 0 THEN &quot;Plan not specified&quot;&#10;ELSEIF SUM([ActualAcquisitions]) &gt;= SUM([TargetAcquisitions]) THEN &quot;On the plan or above&quot;&#10;ELSE &quot;Below plan&quot;&#10;END' />
      </column>
