        <calculation class='tableau' formula='IF SUM([Eligible12Flag]) &gt; 0&#10;THEN SUM([Retained12Flag]) / SUM([Eligible12Flag])&#10;END' />
      </column>
      <column caption='12M Cohort Coverage %' datatype='real' default-format='p0.0%' name='[Calculation_2794116628996122]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD([CustomerID]) &gt; 0&#10;THEN SUM([Eligible12Flag]) / COUNTD([CustomerID])&#10;END' />
